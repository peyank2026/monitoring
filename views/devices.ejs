<%- include('partials/header', { title: 'Devices', activePage: 'devices' }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="m-0">Device Management</h5>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addDeviceModal">
        <i class="fas fa-plus"></i> Add Device
    </button>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>IP Address</th>
                        <th>Vendor</th>
                        <th>Community</th>
                        <th>Location</th>
                        <th>Active</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof devices !== 'undefined' && devices.length > 0) { %>
                        <% devices.forEach((dev, index) => { %>
                            <tr>
                                <td><%= index + 1 %></td>
                                <td>
                                    <% if (dev.vendor === 'mikrotik' || dev.vendor === 'huawei') { %>
                                        <img class="vendor-list-logo" src="/images/<%= dev.vendor %>-symbol.svg" alt="<%= dev.vendor === 'mikrotik' ? 'MikroTik' : 'Huawei' %> logo">
                                    <% } %>
                                    <%= dev.name %>
                                </td>
                                <td><%= dev.ip_address %></td>
                                <td>
                                    <span class="badge badge-<%= dev.vendor.toLowerCase() %>"><%= dev.vendor %></span>
                                </td>
                                <td><%= dev.snmp_community || 'public' %></td>
                                <td><%= dev.location || 'N/A' %></td>
                                <td>
                                    <% if (dev.is_active) { %>
                                        <span class="badge bg-success">Yes</span>
                                    <% } else { %>
                                        <span class="badge bg-secondary">No</span>
                                    <% } %>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-secondary edit-device-btn" 
                                        data-id="<%= dev.id || dev._id %>"
                                        data-name="<%= dev.name %>"
                                        data-ip="<%= dev.ip_address %>"
                                        data-vendor="<%= dev.vendor %>"
                                        data-community="<%= dev.snmp_community %>"
                                        data-version="<%= dev.snmp_version %>"
                                        data-location="<%= dev.location %>"
                                        data-active="<%= dev.is_active ? 'true' : 'false' %>">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <form action="/devices/<%= dev.id || dev._id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this device?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" class="text-center py-4">No devices configured yet.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Device Modal -->
<div class="modal fade" id="addDeviceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/devices" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Device</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Device Name</label>
                        <input type="text" class="form-control" name="name" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">IP Address</label>
                        <input type="text" class="form-control" name="ip_address" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Vendor</label>
                        <select class="form-select" name="vendor" required>
                            <option value="mikrotik">MikroTik</option>
                            <option value="huawei">Huawei</option>
                            <option value="cisco">Cisco</option>
                            <option value="juniper">Juniper</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">SNMP Community</label>
                            <input type="text" class="form-control" name="snmp_community" value="public" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">SNMP Version</label>
                            <select class="form-select" name="snmp_version">
                                <option value="2">v2c</option>
                                <option value="1">v1</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Location</label>
                        <input type="text" class="form-control" name="location">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Device</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Device Modal -->
<div class="modal fade" id="editDeviceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editDeviceForm" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Device</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Device Name</label>
                        <input type="text" class="form-control" name="name" id="edit_name" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">IP Address</label>
                        <input type="text" class="form-control" name="ip_address" id="edit_ip" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Vendor</label>
                        <select class="form-select" name="vendor" id="edit_vendor" required>
                            <option value="mikrotik">MikroTik</option>
                            <option value="huawei">Huawei</option>
                            <option value="cisco">Cisco</option>
                            <option value="juniper">Juniper</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">SNMP Community</label>
                            <input type="text" class="form-control" name="snmp_community" id="edit_community" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">SNMP Version</label>
                            <select class="form-select" name="snmp_version" id="edit_version">
                                <option value="2">v2c</option>
                                <option value="1">v1</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Location</label>
                        <input type="text" class="form-control" name="location" id="edit_location">
                    </div>
                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" name="is_active" id="edit_is_active">
                        <label class="form-check-label" for="edit_is_active">Active monitoring</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Device</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const editBtns = document.querySelectorAll('.edit-device-btn');
    const editModal = new bootstrap.Modal(document.getElementById('editDeviceModal'));
    const editForm = document.getElementById('editDeviceForm');
    
    editBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
            const btnEl = e.currentTarget;
            document.getElementById('edit_name').value = btnEl.dataset.name;
            document.getElementById('edit_ip').value = btnEl.dataset.ip;
            document.getElementById('edit_vendor').value = btnEl.dataset.vendor.toLowerCase();
            document.getElementById('edit_community').value = btnEl.dataset.community;
            document.getElementById('edit_version').value = btnEl.dataset.version || '2';
            document.getElementById('edit_location').value = btnEl.dataset.location;
            document.getElementById('edit_is_active').checked = btnEl.dataset.active === 'true';
            
            editForm.action = '/devices/' + btnEl.dataset.id + '/update';
            editModal.show();
        });
    });
});
</script>

<%- include('partials/footer') %>
