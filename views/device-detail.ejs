<%- include('partials/header', { title: typeof device !== 'undefined' ? device.name : 'Device Detail', activePage: 'devices' }) %>

<% if (typeof device !== 'undefined') { %>
<%
    const opticalLabels = {
        excellent: 'Excellent',
        good: 'Good',
        warning: 'Warning',
        'no-data': 'No Data',
        disabled: 'Disabled'
    };
%>
<div class="row mb-4">
    <div class="col-md-12">
        <div class="card shadow-sm border-0">
            <div class="card-body d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <h4 class="mb-1">
                        <% if (device.vendor === 'mikrotik' || device.vendor === 'huawei') { %>
                            <img class="vendor-heading-logo" src="/images/<%= device.vendor %>-symbol.svg" alt="<%= device.vendor === 'mikrotik' ? 'MikroTik' : 'Huawei' %> logo">
                        <% } %>
                        <%= device.name %> <span class="badge badge-<%= device.vendor.toLowerCase() %> ms-2"><%= device.vendor %></span>
                    </h4>
                    <p class="text-muted mb-0">
                        <i class="fas fa-network-wired"></i> <%= device.ip_address %> &nbsp;|&nbsp; 
                        <i class="fas fa-map-marker-alt"></i> <%= device.location || 'N/A' %> &nbsp;|&nbsp;
                        <i class="fas fa-clock"></i> Last Polled: <%= device.last_polled ? new Date(device.last_polled).toLocaleString() : 'Never' %>
                    </p>
                </div>
                <div class="text-end mt-3 mt-md-0">
                    <span class="d-inline-block me-3">
                        Optical:
                        <span class="device-status status-<%= device.optical_status %>" title="<%= device.last_poll_error || '' %>">
                            <span class="device-status-dot" aria-hidden="true"></span>
                            <%= opticalLabels[device.optical_status] %>
                        </span>
                    </span>
                    <button class="btn btn-primary" id="manualPollBtn" onclick="pollDevice('<%= device.id || device._id %>')">
                        <i class="fas fa-sync"></i> Manual Poll
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="chart-section d-none mb-4" id="chartSection">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-container traffic-chart-card shadow-sm border-0">
                <div class="traffic-chart-header">
                    <div>
                        <div class="traffic-chart-eyebrow"><i class="fas fa-wave-square me-2"></i>MRTG traffic view</div>
                        <h5 class="traffic-chart-title" id="trafficChartTitle">Traffic History</h5>
                        <div class="traffic-chart-meta" id="trafficChartMeta">24 Jam · waktu WIB</div>
                    </div>
                    <div class="traffic-chart-actions">
                        <label for="trafficRange" class="small text-muted text-nowrap mb-0">Rentang:</label>
                        <select id="trafficRange" class="form-select form-select-sm" onchange="changeTrafficRange()">
                            <option value="6h">6 Jam</option>
                            <option value="12h">12 Jam</option>
                            <option value="24h" selected>24 Jam</option>
                            <option value="1w">1 Minggu</option>
                            <option value="2w">2 Minggu</option>
                            <option value="1mo">1 Bulan</option>
                            <option value="2mo">2 Bulan</option>
                            <option value="3mo">3 Bulan</option>
                            <option value="6mo">6 Bulan</option>
                            <option value="1y">1 Tahun</option>
                            <option value="2y">2 Tahun</option>
                            <option value="custom">Pilih tanggal &amp; jam</option>
                        </select>
                        <button class="btn-close" onclick="hideCharts()" aria-label="Close chart"></button>
                    </div>
                </div>
                <div class="chart-custom-range d-none" id="trafficCustomRange">
                    <label for="trafficStartAt">Dari</label>
                    <input type="datetime-local" class="form-control form-control-sm" id="trafficStartAt" step="60">
                    <label for="trafficEndAt">Sampai</label>
                    <input type="datetime-local" class="form-control form-control-sm" id="trafficEndAt" step="60">
                    <button type="button" class="btn btn-sm btn-primary" id="trafficCustomUpdate" onclick="applyTrafficCustomRange()">
                        <i class="fas fa-rotate me-1"></i>Update
                    </button>
                    <span class="chart-range-error" id="trafficRangeError" role="alert"></span>
                </div>
                <div class="traffic-chart-plot">
                    <canvas id="trafficChart"></canvas>
                    <div class="traffic-chart-empty" id="trafficChartEmpty">Memuat histori trafik…</div>
                </div>
                <div class="traffic-stats" id="mrtgStats">
                    <div class="traffic-stats-head" aria-hidden="true">
                        <span>Traffic</span><span>Now</span><span>Average</span><span>Maximum</span><span>95th %</span>
                    </div>
                    <div class="traffic-stats-row traffic-in-row">
                        <span class="traffic-series-label"><span class="traffic-swatch traffic-swatch-in"></span>In</span>
                        <strong id="mrtgInCurr">0 bps</strong>
                        <span id="mrtgInAvg">0 bps</span>
                        <span id="mrtgInMax">0 bps</span>
                        <span id="mrtgIn95">0 bps</span>
                    </div>
                    <div class="traffic-stats-row traffic-out-row">
                        <span class="traffic-series-label"><span class="traffic-swatch traffic-swatch-out"></span>Out</span>
                        <strong id="mrtgOutCurr">0 bps</strong>
                        <span id="mrtgOutAvg">0 bps</span>
                        <span id="mrtgOutMax">0 bps</span>
                        <span id="mrtgOut95">0 bps</span>
                    </div>
                    <div class="traffic-volume-row">
                        <span>Total estimasi: <strong>In <span id="mrtgTotalIn">0 B</span></strong> · <strong>Out <span id="mrtgTotalOut">0 B</span></strong></span>
                        <span><span id="mrtgSampleCount">0 titik data</span> · <span id="mrtgUpdatedAt">Belum ada data</span></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <h5 class="card-title mb-3">Interfaces</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle" id="interfacesTable">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Interface</th>
                        <th>Status</th>
                        <th>Speed</th>
                        <th>TX Power (dBm)</th>
                        <th>RX Power (dBm)</th>
                        <th>Traffic In</th>
                        <th>Traffic Out</th>
                        <th>Chart</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof interfaces !== 'undefined' && interfaces.length > 0) { %>
                        <% interfaces.forEach((iface, index) => { 
                            const rxNum = (iface.rx_power !== null && iface.rx_power !== undefined && iface.rx_power !== '') ? parseFloat(iface.rx_power) : null;
                            const txNum = (iface.tx_power !== null && iface.tx_power !== undefined && iface.tx_power !== '') ? parseFloat(iface.tx_power) : null;

                            let rxClass = '';
                            let rxQuality = null;
                            if (rxNum !== null && !isNaN(rxNum)) {
                                if (rxNum >= -15) rxQuality = 'excellent';
                                else if (rxNum >= -20) rxQuality = 'good';
                                else rxQuality = 'warning';
                                rxClass = `power-${rxQuality}`;
                            }
                        %>
                            <tr class="<%= rxQuality === 'warning' ? 'table-warning' : '' %>">
                                <td><%= iface.if_index %></td>
                                <td>
                                    <strong><%= iface.if_name %></strong>
                                    <% if (iface.if_alias) { %>
                                        <br><small class="text-muted"><%= iface.if_alias %></small>
                                    <% } %>
                                </td>
                                <td>
                                    <span class="status-dot <%= iface.if_status === 'up' || iface.if_status === 1 ? 'up' : 'down' %>"></span>
                                    <%= iface.if_status === 'up' || iface.if_status === 1 ? 'Up' : 'Down' %>
                                </td>
                                <td><span class="speed-val" data-speed="<%= iface.if_speed %>"><%= iface.if_speed %></span></td>
                                <td><%= (txNum !== null && !isNaN(txNum)) ? txNum.toFixed(3) : 'N/A' %></td>
                                <td class="fw-bold <%= rxClass %>">
                                    <%= (rxNum !== null && !isNaN(rxNum)) ? rxNum.toFixed(3) : 'N/A' %>
                                    <% if (rxQuality) { %>
                                        <span class="optical-grade status-<%= rxQuality %>"><%= opticalLabels[rxQuality] %></span>
                                    <% } %>
                                </td>
                                <td><span class="traffic-val" data-bps="<%= iface.in_traffic_bps || 0 %>">0</span></td>
                                <td><span class="traffic-val" data-bps="<%= iface.out_traffic_bps || 0 %>">0</span></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-info" 
                                        onclick="showCharts('<%= device.id || device._id %>', '<%= iface.if_index %>', '<%= iface.if_name %>')">
                                        <i class="fas fa-chart-line"></i>
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="9" class="text-center py-4">No interfaces found for this device.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
<% } else { %>
    <div class="alert alert-warning">Device not found.</div>
<% } %>

<script src="/js/device-detail.js"></script>

<%- include('partials/footer') %>
