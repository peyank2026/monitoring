<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Switch Monitor - <%= typeof title !== 'undefined' ? title : 'Dashboard' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <% if (typeof fullName !== 'undefined' && fullName) { %>
        <div class="sidebar">
            <div class="sidebar-brand">
                <img src="/images/network-switch.png" class="sidebar-brand-image" alt="">
                <span>Switch Monitor</span>
            </div>
            <nav class="sidebar-nav">
                <a href="/dashboard" class="<%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">
                    <i class="fas fa-network-wired"></i> Switch Dashboard
                </a>
                <a href="/latency" class="<%= typeof activePage !== 'undefined' && activePage === 'latency' ? 'active' : '' %>">
                    <i class="fas fa-wave-square"></i> Latency Dashboard
                </a>
                <a href="/devices" class="<%= typeof activePage !== 'undefined' && activePage === 'devices' ? 'active' : '' %>">
                    <i class="fas fa-server"></i> Devices
                </a>
                <% if (typeof userRole !== 'undefined' && userRole === 'admin') { %>
                    <a href="/users" class="<%= typeof activePage !== 'undefined' && activePage === 'users' ? 'active' : '' %>">
                        <i class="fas fa-users-cog"></i> User Management
                    </a>
                <% } %>
            </nav>
            <div class="sidebar-footer">
                <small>Logged in as: <%= fullName || username %></small><br>
                <a href="/change-password" class="text-white mt-2 d-inline-block text-decoration-none">
                    <i class="fas fa-key"></i> Change Password
                </a><br>
                <a href="/logout" class="text-white mt-2 d-inline-block text-decoration-none">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </div>
        </div>
        <div class="main-content">
            <nav class="top-navbar">
                <h4 class="m-0"><%= typeof title !== 'undefined' ? title : 'Dashboard' %></h4>
                <% if (typeof activePage !== 'undefined' && activePage === 'dashboard') { %>
                    <button class="btn btn-outline-primary btn-sm" id="manualGlobalPollBtn">
                        <i class="fas fa-sync"></i> Poll Switches
                    </button>
                <% } else if (typeof activePage !== 'undefined' && activePage === 'latency') { %>
                    <form action="/hosts/check-all" method="POST" class="m-0">
                        <button class="btn btn-outline-primary btn-sm" type="submit">
                            <i class="fas fa-sync"></i> Check All Hosts
                        </button>
                    </form>
                <% } %>
            </nav>
            <div class="content-area">
    <% } else { %>
        <div class="main-content" style="margin-left: 0;">
            <div class="content-area">
    <% } %>
